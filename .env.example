# Copy to .env (never commit .env). Nothing is hard-coded: set the provider, URL and model names you use.
# Any OpenAI-compatible provider works (Groq, OpenAI, Gemini's compat endpoint, OpenRouter, Together, Ollama...).

# --- Brain (required) ---
LLM_API_KEY=
LLM_BASE_URL=          # e.g. https://api.openai.com/v1 | http://localhost:11434/v1
LLM_MODEL=             # must follow instructions and return JSON; small models often fail the transfer-lookup turn
# LLM_FALLBACK_MODELS= # optional, comma-separated, same key and URL; tried when the main model's daily budget runs out
# LLM_JSON_MODE=json_schema   # json_object or none if your provider rejects json_schema
# LLM_REASONING_EFFORT=       # optional, sent only if set (for providers/models that accept reasoning_effort)

# --- Voice agent only (required for voice). STT/TTS key and URL default to the LLM ones. ---
STT_MODEL=             # speech-to-text model name
# STT_LANGUAGE=en      # optional
# STT_API_KEY=  STT_BASE_URL=
TTS_MODEL=             # text-to-speech model name
TTS_VOICE=             # voice name
# TTS_RESPONSE_FORMAT=wav   # audio format asked from the provider (wav, mp3, ...)
# TTS_SAMPLE_RATE=24000
# TTS_API_KEY=  TTS_BASE_URL=
