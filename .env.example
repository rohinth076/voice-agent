# Copy to .env (never commit .env). Both keys are free to create.
GEMINI_API_KEY=            # https://aistudio.google.com/  (used only if you run a Gemini model)
GROQ_API_KEY=              # https://console.groq.com/     (voice agent: STT + TTS + the brain model)
# Orpheus text-to-speech also needs its model terms accepted once in the Groq console playground.
